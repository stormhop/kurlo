---
import SiteLayout from '../components/SiteLayout.astro';
import Scene from '../components/Scene.astro';
import DownloadButton from '../components/site/DownloadButton.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const title = 'There is no pricing page — Kurlo';
const description = 'Kurlo has no paid plan. Every feature is in the free, open-source app.';
const curl = 'curl -i https://kurlo.dev/pricing';

const headers = [
  ['server', 'nginx'],
  ['content-type', 'text/plain'],
  ['content-length', '66'],
];

const tests = ['no paywall', 'no seat limit', 'no account required'];
---

<SiteLayout title={title} description={description} noindex>
  <section class="k-hero" data-hero data-replies="404 Not Found · 38 ms|404 Not Found · 12 ms|still 404 · 9 ms" aria-labelledby="hero-title">
    <Scene variant="night" eager />
    <div class="k-hero-copy k-miss">
      <div>
        <p class="k-label k-label-hero">GET /pricing → 404</p>
        <h1 id="hero-title" class="k-h1-long"><span>No</span><span>pricing.</span></h1>
        <p class="k-lead">Every feature is in the free app, so there is nothing to sell you. No seats, no trial, no plan to outgrow. The code is MIT licensed on GitHub.</p>
        <div class="k-cta">
          <DownloadButton />
          <button class="k-btn k-btn-glass" type="button" data-copy={curl} aria-label={`Copy ${curl}`}>
            <span class="k-dollar" aria-hidden="true">$</span>
            <code>{curl}</code>
            <span class="k-tag" data-copy-tag>Copy</span>
          </button>
          <a class="k-source" href={`${base}#compare`}>Compare with Postman and Bruno</a>
        </div>
      </div>
      <div class="k-app" data-tabs aria-label="Kurlo showing GET https://kurlo.dev/pricing answered with 404 Not Found">
        <div class="k-app-bar"><i></i><i></i><i></i><span>Kurlo</span></div>
        <div class="k-app-body">
          <div class="k-app-main">
            <div class="k-app-url">
              <span class="k-method m-get">GET</span>
              <span class="k-url">https://kurlo.dev/pricing</span>
              <span class="k-send" aria-hidden="true"><span>Send</span></span>
            </div>
            <div class="k-app-res">
              <div class="k-app-res-head">
                <div class="k-app-tabs" role="tablist" aria-label="Response">
                  <button type="button" role="tab" class="on" aria-selected="true" tabindex="0" data-tab="body">Body</button>
                  <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="headers">Headers</button>
                  <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="tests">Tests <span class="ok">{tests.length}/{tests.length}</span></button>
                </div>
                <div class="k-app-stat"><b class="bad">404 Not Found</b><span>38 ms</span><span>66 B</span></div>
              </div>
              <div class="k-app-res-body">
                <pre class="k-code" role="tabpanel" data-panel="body">Every feature is in the free app.
There is nothing to upgrade to.</pre>
                <pre class="k-code" role="tabpanel" data-panel="headers" hidden>{headers.map(([name, value]) => <><span class="k">{name}</span>: {value}{'\n'}</>)}</pre>
                <ul class="k-tests" role="tabpanel" data-panel="tests" hidden>
                  {tests.map(test => <li class="ok"><b>✓</b>pm.test("{test}")</li>)}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
