---
import SiteLayout from '../components/SiteLayout.astro';
import Scene from '../components/Scene.astro';
import DownloadButton from '../components/site/DownloadButton.astro';
import InstallButton from '../components/site/InstallButton.astro';
import EndCta from '../components/site/EndCta.astro';
import Rich from '../components/site/Rich.astro';
import requestEditor from '../assets/screenshots/request-editor.png';
import { structuredData } from '../../site.schema.mjs';
import { GITHUB_SOURCE } from '../../site.constants.mjs';
import { competitors } from '../lib/competitors';
import { RECEIPTS_CHECKED_ON, apps, formatMb, mb, platforms, smallestRival, timesSmaller } from '../lib/receipts';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const site = Astro.site ? new URL(base, Astro.site).toString() : base;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const title = 'Kurlo — free, open-source API client and Postman alternative';
const description = 'A free, open-source desktop API client and Postman alternative for HTTP, GraphQL, gRPC, WebSocket, Socket.IO, SSE and MCP. Requests are YAML files in your repo, and your AI agent can run and edit them. No account, no cloud, no telemetry.';
const terms = /(pm\.sendRequest|kurlo run|kurlo mcp|pm\.\*|\[secret\]|\.proto)/g;

const features = [
  {
    title: 'Lives in your repo.',
    text: 'Every request is a YAML file next to your code. It gets reviewed in a pull request and merged with your branch, and secrets stay on your machine as placeholders.',
    link: 'docs/guides/git-workspaces/',
    plate: 'a',
    visual: 'yaml',
  },
  {
    title: 'Your agent can press Send.',
    text: 'Kurlo is an MCP server too. Claude Code, Codex or Cursor runs your saved requests, writes new ones with tests, and reads the response you just got. Tokens reach your API, never the model.',
    link: 'mcp/',
    plate: 'b',
    visual: 'video',
  },
  {
    title: 'Find your API’s limits.',
    text: 'Turn saved requests into load tests powered by k6. Build a flow, ramp up virtual users or iterations per second, and set limits for response times and failures. Run locally, export a k6 script or use the CLI.',
    link: 'docs/guides/load-testing/',
    plate: 'c',
    visual: 'load',
  },
  {
    title: 'Postman scripts, unchanged.',
    text: 'Drop a Postman v2.1 export on the sidebar. Folders, auth, environments and saved responses come across, and the pm.* tests keep running. Nothing to rewrite.',
    link: 'docs/getting-started/migrating/',
    plate: 'c',
    visual: 'script',
  },
  {
    title: 'Mock it before it exists.',
    text: 'Serve a collection’s saved examples on localhost while the real endpoint is still being built. No account, no request quota.',
    link: 'docs/guides/mock-server/',
    plate: 'd',
    visual: 'mock',
  },
  {
    title: 'Same tests in CI.',
    text: 'kurlo run sends the same requests with the same scripts in your pipeline. A failing test fails the build.',
    link: 'docs/guides/cli-runner/',
    plate: 'a',
    visual: 'ci',
  },
  {
    title: 'Sees CORS before your users do.',
    text: 'Send a request the way a page on another origin would. The missing header shows up here, not in a bug report.',
    link: 'docs/guides/browser-security/',
    plate: 'b',
    visual: 'cors',
  },
  {
    title: 'Every environment, one table.',
    text: 'Every variable across every environment side by side, so the one missing from staging stands out.',
    link: 'docs/guides/environments/',
    plate: 'c',
    visual: 'envs',
  },
  {
    title: 'Speaks everything.',
    text: 'HTTP/1.1 and 2, GraphQL with a schema explorer, gRPC, WebSocket, Socket.IO, SSE, and MCP servers you can call by hand.',
    link: 'docs/guides/request-types/',
    plate: 'd',
    visual: 'protocols',
  },
];

const also = [
  { title: 'Auth, all of it', text: 'OAuth 2.0 with all four grants, PKCE and refresh, AWS SigV4, Digest, API keys and client certificates.', link: 'docs/guides/authentication/' },
  { title: 'Moves in for you', text: 'Postman, Insomnia, Bruno, OpenAPI, HAR and cURL. The original files are never touched.', link: 'docs/getting-started/migrating/' },
  { title: 'Your browser’s cookies', text: 'An extension for Chrome, Edge, Brave and Firefox sends the session you are already signed into.', link: 'docs/guides/cookies/' },
  { title: 'Remembers', text: 'Every send with its response, kept for 14 days and reopenable in the editor.', link: 'docs/guides/history/' },
  { title: 'Runs with data', text: 'A whole collection over a CSV or JSON data file, right in the app.', link: 'docs/guides/cli-runner/' },
  { title: 'Saves to disk', text: 'Send and download writes a binary response straight to a file, byte for byte.' },
  { title: 'Keeps secrets home', text: 'In a shared repo, tokens are placeholders. The values live encrypted on your machine.', link: 'privacy/' },
  { title: 'Fences off production', text: 'Mark an environment protected and your agent can’t send a thing with it.', link: 'docs/guides/mcp-server/' },
  { title: 'Notices outside edits', text: 'Change a file in your editor, or let the agent do it, and the open app merges it in.' },
  { title: 'Tests your MCP server', text: 'Discover tools, call them with arguments from their schema and read the raw JSON-RPC.', link: 'mcp/' },
  { title: 'Locks the drawer', text: 'Local data is AES-256-GCM encrypted, with the key in Keychain, DPAPI or libsecret.', link: 'privacy/' },
  { title: 'Updates itself', text: 'Checks for a signed release on launch. No usage data rides along.', link: 'privacy/' },
];

const parts = [
  { part: 'HTTP', details: '1.1 and 2, with proxies and client certificates.', status: 'Yes', tone: 'yes' },
  { part: 'GraphQL', details: 'Queries, variables and a schema explorer.', status: 'Yes', tone: 'yes' },
  { part: 'gRPC', details: 'Server reflection or your own .proto files.', status: 'Yes', tone: 'yes' },
  { part: 'Realtime', details: 'WebSocket, Socket.IO and SSE sessions.', status: 'Yes', tone: 'yes' },
  { part: 'MCP servers', details: 'Streamable HTTP, every revision since 2025-03-26. The stdio transport is still to come.', status: 'Partly', tone: 'part' },
  { part: 'Postman scripts', details: 'pm.*, pm.sendRequest, chai and CryptoJS.', status: 'Yes', tone: 'yes' },
  { part: 'Git', details: 'Clone, commit, pull and push without leaving the app.', status: 'Yes', tone: 'yes' },
  { part: 'Account', details: 'There is no Kurlo server to have one on.', status: 'None', tone: 'yes' },
  { part: 'Telemetry', details: 'Update checks ask GitHub for one file. That’s it.', status: 'None', tone: 'yes' },
  { part: 'Platforms', details: 'macOS 12+, Windows 10+ on x64 and Arm64, Linux x64.', status: 'Yes', tone: 'yes' },
];

const faq = [
  { q: 'What does it cost?', a: 'Nothing. It’s open source under MIT. No paid tier, no seats, no catch.' },
  { q: 'Do I need an account?', a: 'No. There is no Kurlo server, so there is nothing to sign in to.' },
  { q: 'What does it collect?', a: 'Nothing. On launch it asks GitHub whether a newer release exists, with no usage data in the request. Everything else goes only where you send it.', link: 'privacy/' },
  { q: 'Does my agent see my tokens?', a: 'No. Secrets reach your API, but the agent sees [secret]. Environments you protect are off limits to it entirely.', link: 'docs/guides/mcp-server/' },
  { q: 'Coming from Postman?', a: 'Export the collection as v2.1 and drop it on the sidebar. Your tests keep running as pm.*, so there’s nothing to rewrite.', link: 'docs/getting-started/migrating/' },
  { q: 'Why does macOS hesitate to open it?', a: 'It isn’t notarized yet. Allow it once in System Settings › Privacy & Security and it opens normally from then on.', link: 'docs/getting-started/installation/' },
];

const kurloApp = apps[0];
const maxMb = (platform: (typeof platforms)[number]['id']) => Math.max(...apps.map(app => mb(app.downloads[platform].bytes)));

const ldJson = structuredData({
  siteRoot: site,
  description,
  screenshot: new URL(requestEditor.src, site).href,
  page: { url: site, name: title, description },
});
---

<SiteLayout title={title} description={description} canonical={site} ldJson={ldJson} links={[{ label: 'Features', href: '#features' }, { label: 'MCP', href: href('mcp/') }, { label: 'Receipts', href: '#receipts' }, { label: 'Compare', href: '#compare' }]}>
  <section class="k-hero" data-hero aria-labelledby="hero-title">
    <Scene variant="dusk" bird />
    <p class="k-hint" data-hint aria-hidden="true">Click the sky <svg width="38" height="22" viewBox="0 0 38 22" fill="none"><path d="M2 4c10 0 22 2 32 14m0 0-1-8m1 8-8-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></p>
    <div class="k-hero-copy">
      <h1 id="hero-title"><span>Send</span><span>it.</span></h1>
      <p class="k-lead">The open-source API client your AI agent can use. Postman’s scripts, YAML in your repo, no account.</p>
      <div class="k-cta">
        <DownloadButton />
        <InstallButton />
        <a class="k-source" href={GITHUB_SOURCE}>Read the source</a>
      </div>
    </div>
    <p class="k-counter" data-counter hidden>Delivered <b data-count>0</b></p>
  </section>

  <section class="k-live" aria-labelledby="live-title">
    <div class="k-live-head">
      <h2 id="live-title" data-live-title>Not a screenshot.</h2>
      <p class="k-kicker" data-live-kicker>Go on, hit Send</p>
    </div>
    <div class="k-app" data-app>
      <div class="k-app-bar"><i></i><i></i><i></i><span>Kurlo — Shop API</span></div>
      <div class="k-app-body">
        <aside class="k-app-side" aria-label="Requests">
          <div class="k-app-col">Shop API</div>
          <div class="k-app-folder">Orders</div>
          <div class="k-app-list" role="listbox" aria-label="Saved requests" data-list></div>
        </aside>
        <div class="k-app-main">
          <div class="k-app-url">
            <span class="k-method" data-method></span>
            <span class="k-url" data-url></span>
            <button class="k-send" type="button" data-send><span>Send</span><kbd>⌘↵</kbd></button>
          </div>
          <div class="k-app-req">
            <div class="k-app-tabs"><span class="on" data-req-label>Body</span><span>Headers</span><span>Auth</span><span>Scripts</span></div>
            <pre class="k-code" data-req></pre>
          </div>
          <div class="k-app-res" data-res>
            <div class="k-app-res-head">
              <div class="k-app-tabs" role="tablist" aria-label="Response">
                <button type="button" role="tab" class="on" data-res-tab="body" aria-selected="true">Body</button>
                <button type="button" role="tab" data-res-tab="tests" aria-selected="false">Tests <span data-tests-count></span></button>
              </div>
              <div class="k-app-stat" data-stat aria-live="polite"></div>
            </div>
            <div class="k-app-res-body" data-res-body>
              <p class="k-empty">Hit Send to get a response</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="k-features" id="features" aria-label="Features">
    {features.map((feature, i) => (
      <article class={`k-feature ${i % 2 ? 'k-feature-flip' : ''}`}>
        <div class="k-feature-copy">
          <p class="k-no"><span class="k-dot" aria-hidden="true"></span>No. {String(i + 1).padStart(2, '0')}</p>
          <h3>{feature.title}</h3>
          <p><Rich text={feature.text} terms={terms} /> <a href={href(feature.link)}>More</a></p>
        </div>
        <div class={`k-plate k-plate-${feature.plate}`}>
          {feature.visual === 'yaml' && (
            <figure class="k-card">
              <figcaption><span>requests/Refund-order.yml</span><span class="k-git">+10</span></figcaption>
<pre><span class="k">version</span>: 1
<span class="k">request</span>:
    <span class="k">name</span>: Refund order
    <span class="k">method</span>: POST
    <span class="k">url</span>: <span class="s">'&#123;&#123;baseUrl&#125;&#125;/orders/&#123;&#123;orderId&#125;&#125;/refund'</span>
    <span class="k">headers</span>:
        - <span class="k">key</span>: Authorization
          <span class="k">value</span>: <span class="s">'Bearer &#123;&#123;kurloSecret:token&#125;&#125;'</span>
    <span class="k">bodyContent</span>: <span class="s">'&#123;"reason":"damaged"&#125;'</span>
    <span class="k">testScriptJs</span>: <span class="f">pm.test</span>(<span class="s">"refunded"</span>, …)</pre>
            </figure>
          )}
          {feature.visual === 'video' && (
            <figure class="k-video">
              <video src={href('media/agent-demo.mp4')} poster={href('media/agent-demo.jpg')} width="1600" height="1214" autoplay muted loop playsinline preload="metadata" data-motion aria-label="Claude Code adds tests to a Kurlo collection over MCP, finds that an order total ignores quantity, fixes the server and runs the collection again while the tests appear in Kurlo"></video>
            </figure>
          )}
          {feature.visual === 'load' && (
            <figure class="k-card">
              <figcaption><span>Load test · Checkout flow</span><span>k6 · local</span></figcaption>
<pre><span class="dim">01</span> <span class="ok">POST</span> /login      → save token
<span class="dim">02</span> <span class="ok">GET</span>  /products   → status 200
<span class="dim">03</span> <span class="ok">POST</span> /orders     → status 201</pre>
              <svg class="k-load-chart" viewBox="0 0 480 110" role="img" aria-label="Example load profile: ramp up to 50 virtual users, hold, then ramp down">
                <path d="M0 100 L90 20 H350 L440 100 Z" fill="currentColor" opacity="0.15" />
                <path d="M0 100 L90 20 H350 L440 100 H480" fill="none" stroke="currentColor" stroke-width="2" />
                <text x="110" y="52" fill="currentColor" font-size="13">50 virtual users · ramp, hold, down</text>
              </svg>
              <div class="k-out">
                <span class="dim">Example result · pass criteria</span>
                <span><b class="ok">✓</b> p95 response time &lt; 500 ms</span>
                <span><b class="ok">✓</b> failed requests &lt; 1%</span>
              </div>
            </figure>
          )}
          {feature.visual === 'script' && (
            <figure class="k-card">
              <figcaption><span>Login user · Tests</span><span>imported from Postman</span></figcaption>
<pre><span class="f">pm.test</span>(<span class="s">"status is 200"</span>, () =&gt; &#123;
  pm.response.to.have.status(200)
&#125;)

<span class="f">pm.test</span>(<span class="s">"returns a session"</span>, () =&gt; &#123;
  const body = pm.response.json()
  pm.environment.set(<span class="s">"token"</span>, body.token)
&#125;)</pre>
              <div class="k-out"><span><b class="ok">✓</b> status is 200</span><span><b class="ok">✓</b> returns a session</span></div>
            </figure>
          )}
          {feature.visual === 'mock' && (
            <figure class="k-card">
              <figcaption><span>Mock · Shop API</span><span class="k-live-dot">localhost:3100</span></figcaption>
<pre><span class="dim">$</span> curl -X POST localhost:3100/orders/42/refund
&#123;
  <span class="k">"orderId"</span>: 42,
  <span class="k">"refunded"</span>: 19.00,
  <span class="k">"status"</span>: <span class="s">"refunded"</span>
&#125;</pre>
              <div class="k-out"><span><b class="ok">201</b> matched example <i>Refunded</i></span></div>
            </figure>
          )}
          {feature.visual === 'ci' && (
            <figure class="k-card">
              <figcaption><span>.github/workflows/api.yml</span><span>ubuntu-latest</span></figcaption>
<pre><span class="dim">$</span> kurlo run . --env CI
<b class="ok">✓</b> GET  /health            → 200   42ms  [2/2 tests]
<b class="ok">✓</b> POST /login             → 200   88ms  [1/1 tests]
<b class="ok">✓</b> POST /orders/42/refund  → 201   84ms  [2/2 tests]

<span class="dim">3 requests, 3 passed, 0 failed · 5/5 assertions · 214ms</span></pre>
            </figure>
          )}
          {feature.visual === 'cors' && (
            <figure class="k-card">
              <figcaption><span>Browser check</span><span>origin https://shop.example.com</span></figcaption>
<pre><span class="dim">OPTIONS</span> api.example.com/orders  → 204
  Access-Control-Allow-Methods: GET, POST
  <span class="err">Access-Control-Allow-Origin: missing</span></pre>
              <div class="k-out k-out-err"><span><b>✗</b> A page on shop.example.com can’t read this response</span></div>
            </figure>
          )}
          {feature.visual === 'envs' && (
            <figure class="k-card">
              <figcaption><span>Environments</span><span>3 environments · 4 variables</span></figcaption>
              <table class="k-envs">
                <thead><tr><th><span class="k-sr">Variable</span></th><th>Local</th><th>Staging</th><th>Prod</th></tr></thead>
                <tbody>
                  <tr><th>baseUrl</th><td>localhost:8080</td><td>stg.shop.dev</td><td>api.shop.dev</td></tr>
                  <tr><th>orderId</th><td>42</td><td>42</td><td>—</td></tr>
                  <tr><th>token</th><td>••••••</td><td>••••••</td><td>••••••</td></tr>
                  <tr><th>webhookUrl</th><td>localhost:9000</td><td class="miss">missing</td><td>hooks.shop.dev</td></tr>
                </tbody>
              </table>
            </figure>
          )}
          {feature.visual === 'protocols' && (
            <figure class="k-card">
              <figcaption><span>Shop API</span><span>7 protocols</span></figcaption>
              <ul class="k-protos">
                <li><span class="p-get">GET</span>List orders</li>
                <li><span class="p-gql">GQL</span>Order with items</li>
                <li><span class="p-grpc">gRPC</span>inventory.Stock/Reserve</li>
                <li><span class="p-ws">WS</span>Order updates</li>
                <li><span class="p-sio">SIO</span>Courier chat</li>
                <li><span class="p-sse">SSE</span>Price feed</li>
                <li><span class="p-mcp">MCP</span>Support assistant</li>
              </ul>
            </figure>
          )}
        </div>
      </article>
    ))}
  </section>

  <section class="k-also" aria-labelledby="also-title">
    <h2 class="k-label" id="also-title">Also in there, no screenshot needed</h2>
    <div class="k-also-grid">
      {also.map(item => (
        <div>
          <h3>{item.link ? <a href={href(item.link)}>{item.title}</a> : item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="k-receipts" id="receipts" aria-labelledby="receipts-title" data-tabs>
    <p class="k-label">Download size, measured</p>
    <h2 class="k-display" id="receipts-title">Receipts.</h2>
    <p class="k-sub">No Electron, no bundled Chromium. Kurlo is Go with the WebView your system already has, so the download is a fraction of the others.</p>
    <div class="k-receipt-tabs" role="tablist" aria-label="Platform">
      {platforms.map((platform, i) => (
        <button type="button" role="tab" class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={platform.id}>{platform.label}</button>
      ))}
    </div>
    {platforms.map((platform, i) => {
      const rival = smallestRival(platform.id);
      const top = maxMb(platform.id);
      return (
        <div class="k-receipt" role="tabpanel" aria-label={platform.label} data-panel={platform.id} hidden={i !== 0}>
          <div class="k-big"><b>{timesSmaller(platform.id)}×</b><span>smaller than {rival.name}, the next lightest, on {platform.label}</span></div>
          <div class="k-bars">
            {apps.map(app => (
              <div class={`k-bar ${app === kurloApp ? 'k-bar-kurlo' : ''}`}>
                <span>{app.name}<i>{app.downloads[platform.id].file}</i></span>
                <div><i style={`--w:${((mb(app.downloads[platform.id].bytes) / top) * 100).toFixed(2)}%`}></i></div>
                <b>{formatMb(app.downloads[platform.id].bytes)}</b>
              </div>
            ))}
          </div>
        </div>
      );
    })}
    <p class="k-fine">Size of the official download for each platform on {RECEIPTS_CHECKED_ON}: {apps.map((app, i) => (<>{i > 0 && ', '}<a href={app.source}>{app.name} {app.version}</a></>))}. 1 MB is 1,048,576 bytes.</p>
  </section>

  <section class="k-parts" id="parts" aria-labelledby="parts-title">
    <p class="k-label">Under the hood</p>
    <h2 class="k-display" id="parts-title">What’s in the box.</h2>
    <p class="k-sub">And what isn’t yet. Every row is checkable in the source.</p>
    <table class="k-table">
      <thead><tr><th>Part</th><th>Details</th><th>Status</th></tr></thead>
      <tbody>
        {parts.map(p => (
          <tr>
            <th>{p.part}</th>
            <td><Rich text={p.details} terms={terms} /></td>
            <td><span class={`k-status k-s-${p.tone}`}>{p.status}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="k-wrap" id="compare" aria-labelledby="compare-title">
    <p class="k-label">Side by side</p>
    <h2 class="k-display" id="compare-title">Next to the others.</h2>
    <p class="k-sub">All four send requests well. They differ in what you pay, where your data lives and what you need an account for.</p>
    <div class="k-vs-cards">
      {competitors.map(competitor => (
        <a class="k-vs-card" href={href(`vs/${competitor.slug}/`)}>
          <h3>vs {competitor.name}</h3>
          <p>{competitor.summary}</p>
          <ul>
            {competitor.highlights.map(item => <li><span><Rich text={item} terms={terms} /></span></li>)}
          </ul>
          <span class="k-more">Full comparison</span>
        </a>
      ))}
    </div>
  </section>

  <section class="k-faq" id="faq" aria-labelledby="faq-title">
    <p class="k-label">FAQ</p>
    <h2 class="k-display" id="faq-title">Fair questions.</h2>
    <p class="k-sub">Short answers. All of them true.</p>
    <div class="k-faq-list">
      {faq.map(item => (
        <details>
          <summary>{item.q}</summary>
          <p><Rich text={item.a} terms={terms} />{item.link && <> <a href={href(item.link)}>Read more</a></>}</p>
        </details>
      ))}
    </div>
  </section>

  <EndCta />

  <Fragment slot="scripts">
    <script is:inline>
      (() => {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (still) document.querySelectorAll('video[data-motion]').forEach(video => { video.removeAttribute('autoplay'); video.pause(); video.controls = true; });

        const requests = [
          { method: 'GET', name: 'List orders', url: '{{baseUrl}}/orders?status=paid', label: 'Params', req: 'status = paid\nlimit  = 20', code: 200, text: 'OK', ms: 42, size: '1.2 KB',
            body: { data: [{ id: 41, total: 24.5, status: 'paid' }, { id: 42, total: 19, status: 'paid' }], next: null },
            tests: [['status is 200', true], ['returns paid orders only', true]] },
          { method: 'POST', name: 'Create order', url: '{{baseUrl}}/orders', label: 'Body', req: { sku: 'PGN-01', qty: 2 }, code: 201, text: 'Created', ms: 96, size: '212 B',
            body: { id: 43, status: 'pending', total: 38 },
            tests: [['status is 201', true], ['returns the new id', true]] },
          { method: 'POST', name: 'Refund order', url: '{{baseUrl}}/orders/{{orderId}}/refund', label: 'Body', req: { reason: 'damaged' }, code: 201, text: 'Created', ms: 84, size: '96 B',
            body: { orderId: 42, refunded: 19, status: 'refunded' },
            tests: [['status is 201', true], ['refund amount matches the order', true]] },
          { method: 'DELETE', name: 'Cancel order', url: '{{baseUrl}}/orders/41', label: 'Params', req: 'no params', code: 409, text: 'Conflict', ms: 51, size: '88 B',
            body: { error: 'order_shipped', message: 'Order 41 has already shipped' },
            tests: [['status is 204', false, 'expected response to have status code 204 but got 409'], ['returns no body', false, 'expected an empty body']] },
        ];
        const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const json = value => esc(JSON.stringify(value, null, 2))
          .replace(/(&quot;[^&]*?&quot;)(\s*:)/g, '<span class="k">$1</span>$2')
          .replace(/: (&quot;[^&]*?&quot;)/g, ': <span class="s">$1</span>')
          .replace(/: (-?\d+(?:\.\d+)?|null|true|false)/g, ': <span class="n">$1</span>');
        const vars = url => esc(url).replace(/\{\{(\w+)\}\}/g, '<span class="v">{{$1}}</span>');

        const app = document.querySelector('[data-app]');
        const list = app.querySelector('[data-list]');
        const method = app.querySelector('[data-method]');
        const url = app.querySelector('[data-url]');
        const reqLabel = app.querySelector('[data-req-label]');
        const reqBox = app.querySelector('[data-req]');
        const send = app.querySelector('[data-send]');
        const stat = app.querySelector('[data-stat]');
        const resBody = app.querySelector('[data-res-body]');
        const testsCount = app.querySelector('[data-tests-count]');
        const tabs = [...app.querySelectorAll('[data-res-tab]')];
        const title = document.querySelector('[data-live-title]');
        const kicker = document.querySelector('[data-live-kicker]');
        const sent = new Set();
        let current = 2;
        let tab = 'body';

        const renderRes = () => {
          const r = requests[current];
          if (!sent.has(current)) {
            stat.innerHTML = '';
            testsCount.textContent = '';
            resBody.innerHTML = '<p class="k-empty">Hit Send to get a response</p>';
            return;
          }
          const passed = r.tests.filter(t => t[1]).length;
          stat.innerHTML = `<b class="${r.code < 400 ? 'ok' : 'bad'}">${r.code} ${r.text}</b><span>${r.ms} ms</span><span>${r.size}</span>`;
          testsCount.textContent = `${passed}/${r.tests.length}`;
          testsCount.className = passed === r.tests.length ? 'ok' : 'bad';
          resBody.innerHTML = tab === 'body'
            ? `<pre class="k-code">${json(r.body)}</pre>`
            : `<ul class="k-tests">${r.tests.map(([name, ok, why]) => `<li class="${ok ? 'ok' : 'bad'}"><b>${ok ? '✓' : '✗'}</b>${esc(name)}${why ? `<span>${esc(why)}</span>` : ''}</li>`).join('')}</ul>`;
        };
        const select = i => {
          current = i;
          const r = requests[i];
          [...list.children].forEach((row, j) => { row.classList.toggle('on', j === i); row.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
          method.textContent = r.method;
          method.className = `k-method m-${r.method.toLowerCase()}`;
          url.innerHTML = vars(r.url);
          reqLabel.textContent = r.label;
          reqBox.innerHTML = typeof r.req === 'string' ? esc(r.req) : json(r.req);
          renderRes();
        };
        requests.forEach((r, i) => {
          const row = document.createElement('button');
          row.type = 'button';
          row.setAttribute('role', 'option');
          row.innerHTML = `<span class="m-${r.method.toLowerCase()}">${r.method === 'DELETE' ? 'DEL' : r.method}</span>${esc(r.name)}`;
          row.addEventListener('click', () => select(i));
          list.appendChild(row);
        });
        tabs.forEach(button => button.addEventListener('click', () => {
          tab = button.dataset.resTab;
          tabs.forEach(b => { b.classList.toggle('on', b === button); b.setAttribute('aria-selected', b === button ? 'true' : 'false'); });
          renderRes();
        }));
        const fire = () => {
          if (send.disabled) return;
          send.disabled = true;
          send.classList.add('busy');
          stat.innerHTML = '<span>Sending…</span>';
          const r = requests[current];
          setTimeout(() => {
            sent.add(current);
            send.disabled = false;
            send.classList.remove('busy');
            renderRes();
            resBody.classList.remove('flash');
            void resBody.offsetWidth;
            resBody.classList.add('flash');
            title.textContent = 'Told you.';
            kicker.textContent = r.code < 400 ? 'Now try Cancel order' : 'That one fails on purpose';
          }, still ? 0 : 280 + r.ms * 3);
        };
        send.addEventListener('click', fire);
        app.addEventListener('keydown', event => {
          if (event.key === 'Enter' && (event.metaKey || event.ctrlKey)) { event.preventDefault(); fire(); }
        });
        select(current);
      })();
    </script>
  </Fragment>
</SiteLayout>
