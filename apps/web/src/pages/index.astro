---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/landing.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import requestEditor from '../assets/screenshots/request-editor.png';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const site = Astro.site ? new URL(base, Astro.site).toString() : base;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const title = 'Kurlo — the API client your AI agent can use';
const description = 'A free, open-source desktop API client for HTTP, GraphQL, gRPC, WebSocket, Socket.IO, SSE and MCP. Requests are YAML files in your repo, and your AI agent can run and edit them. No account, no cloud, no telemetry.';
const releases = 'https://github.com/stormhop/kurlo/releases/latest';
const github = 'https://github.com/stormhop/kurlo';

const facts = ['Free and MIT licensed', 'No account', 'No telemetry', 'macOS, Windows, Linux'];

const agentAbilities = [
  { title: 'Run your requests', text: 'Saved requests and whole collections, with their auth, scripts and tests, in the environment you choose.' },
  { title: 'Write requests and tests', text: 'As it writes an endpoint, it adds the request with pm.* tests to your collection, as YAML that lands in the same commit.' },
  { title: 'Read what you just sent', text: 'Ask why your last request failed, and it reads the request and response from the app. Nothing to copy.' },
  { title: 'Keep examples', text: 'It saves real responses as examples, which the mock server serves and responses are compared against.' },
  { title: 'Keep secrets out', text: 'Tokens reach your API but never the model, and nothing it writes contains a secret. Environments you protect, such as production, are off limits.' },
];

const features = [
  { title: 'Every protocol', text: 'HTTP/1.1 and 2, GraphQL with schema explorer, gRPC, WebSocket, Socket.IO, SSE, and MCP servers you can call by hand.', link: 'docs/guides/request-types/' },
  { title: 'Git workspaces', text: 'Requests are readable YAML in your repository, reviewed in pull requests. Secrets stay on your machine as placeholders.', link: 'docs/guides/git-workspaces/' },
  { title: 'Postman scripts', text: 'Pre-request and test scripts in JavaScript with the pm.* API, including pm.sendRequest, chai and CryptoJS.', link: 'docs/guides/scripting/' },
  { title: 'Mock server', text: 'Serve a collection’s saved examples on localhost while the real endpoint is still being built. No request quota.', link: 'docs/guides/mock-server/' },
  { title: 'Runner and CI', text: 'Run a collection with data files in the app, or the same requests and tests in CI with kurlo run.', link: 'docs/guides/cli-runner/' },
  { title: 'Browser checks', text: 'Send a request the way a page on another origin would, and see the CORS or CSP error before your users do.', link: 'docs/guides/browser-security/' },
  { title: 'Environments', text: 'Every variable across every environment in one table, so the value missing from staging is easy to spot.', link: 'docs/guides/environments/' },
  { title: 'Auth', text: 'OAuth 2.0 with all four grants, PKCE and refresh, AWS SigV4, Digest, API keys and client certificates.', link: 'docs/guides/authentication/' },
  { title: 'Browser cookies', text: 'An extension for Chrome, Edge, Brave and Firefox sends the session you are already signed into.', link: 'docs/guides/cookies/' },
  { title: 'History', text: 'Every send with its response, kept for 14 days and reopenable in the editor.', link: 'docs/guides/history/' },
];

type Mark = 'yes' | 'part' | 'no';
type Cell = { mark: Mark; text: string; note?: string };
const tools = ['Kurlo', 'Postman', 'Insomnia', 'Bruno'];
const comparison: { label: string; cells: Cell[] }[] = [
  {
    label: 'Price',
    cells: [
      { mark: 'yes', text: 'Free, every feature' },
      { mark: 'part', text: 'Free for 1 user', note: 'Team plan $19 per user a month' },
      { mark: 'part', text: 'Free up to 3 Git Sync users', note: 'Pro $12 per user a month' },
      { mark: 'part', text: 'Free: 2 workspaces, 5 OpenAPI syncs a month', note: 'Pro $6, Ultimate $11 per user a month' },
    ],
  },
  {
    label: 'Account',
    cells: [
      { mark: 'yes', text: 'Not needed' },
      { mark: 'part', text: 'Required for collections', note: 'Signed out, it only sends one-off requests' },
      { mark: 'part', text: 'Required beyond Scratch Pad' },
      { mark: 'yes', text: 'Not needed' },
    ],
  },
  {
    label: 'Where collections live',
    cells: [
      { mark: 'yes', text: 'Your disk and your Git repo' },
      { mark: 'part', text: 'Postman’s cloud', note: 'Local vault for secrets' },
      { mark: 'part', text: 'Cloud, local or Git' },
      { mark: 'yes', text: 'Your disk and your Git repo' },
    ],
  },
  {
    label: 'Team sharing',
    cells: [
      { mark: 'yes', text: 'Any Git host, no seat limit' },
      { mark: 'part', text: 'Cloud workspaces', note: 'Paid for teams' },
      { mark: 'part', text: 'Git Sync', note: 'Free up to 3 users' },
      { mark: 'part', text: 'Git', note: 'Private Git providers need Pro' },
    ],
  },
  {
    label: 'Source code',
    cells: [
      { mark: 'yes', text: 'MIT' },
      { mark: 'no', text: 'Closed' },
      { mark: 'yes', text: 'Apache-2.0' },
      { mark: 'yes', text: 'MIT core', note: 'Paid editions on top' },
    ],
  },
  {
    label: 'Built on',
    cells: [
      { mark: 'yes', text: 'Native Go with the system WebView' },
      { mark: 'part', text: 'Electron' },
      { mark: 'part', text: 'Electron' },
      { mark: 'part', text: 'Electron' },
    ],
  },
  {
    label: 'Postman scripts',
    cells: [
      { mark: 'yes', text: 'Run as written in pm.*' },
      { mark: 'yes', text: 'Native' },
      { mark: 'part', text: 'Compatibility layer' },
      { mark: 'part', text: 'Converted to bru.* on import', note: 'Complex scripts need rewriting' },
    ],
  },
  {
    label: 'Mock server',
    cells: [
      { mark: 'yes', text: 'Local, no request cap', note: 'Works offline, no account' },
      { mark: 'part', text: 'Cloud-hosted', note: 'Unlimited since March 2026, needs an account' },
      { mark: 'part', text: '1,000 mock requests a month on free' },
      { mark: 'yes', text: 'Local' },
    ],
  },
  {
    label: 'Browser CORS and CSP checks',
    cells: [
      { mark: 'yes', text: 'Built in' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
    ],
  },
  {
    label: 'Sync cookies from your browser',
    cells: [
      { mark: 'yes', text: 'Extension for Chromium and Firefox' },
      { mark: 'yes', text: 'Interceptor extension' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
    ],
  },
];

const codeTerms = /(pm\.sendRequest|kurlo run|kurlo mcp|pm\.\*|bru\.\*)/g;
const withCode = (text: string) => text.split(codeTerms).map((part, i) => (i % 2 ? { code: part } : { text: part }));

const scriptSnippet = [
  '<span class="c">// unchanged from the Postman export</span>',
  '<span class="f">pm.test</span>(<span class="s">"status is 200"</span>, () =&gt; {',
  '  pm.response.to.have.status(200)',
  '})',
  '',
  '<span class="f">pm.test</span>(<span class="s">"returns a session"</span>, () =&gt; {',
  '  const body = pm.response.json()',
  '  pm.expect(body).to.have.property(<span class="s">"token"</span>)',
  '  pm.environment.set(<span class="s">"token"</span>, body.token)',
  '})',
].join('\n');

const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kurlo',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: site,
  downloadUrl: releases,
  sameAs: [github],
});
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site} />
  <link rel="icon" href={href('favicon-32.png')} type="image/png" />
  <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
  <link rel="sitemap" href={href('sitemap-index.xml')} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={site} />
  <meta property="og:image" content={`${site}og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${site}og.png`} />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (() => {
      let stored = null;
      try { stored = localStorage.getItem('starlight-theme'); } catch {}
      const theme = stored === 'light' || stored === 'dark'
        ? stored
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <script is:inline type="application/ld+json" set:html={ldJson} />
</head>
<body class="landing">
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" data-nav>
    <div class="wrap nav-row">
      <a class="brand" href={base} aria-label="Kurlo home">
        <img src={logo.src} alt="" width="28" height="28" />
        <span>Kurlo</span>
      </a>
      <nav class="nav-links" aria-label="Site">
        <a href="#agents">AI agents</a>
        <a href="#features">Features</a>
        <a href="#compare">Compare</a>
        <a href={href('docs/getting-started/installation/')}>Docs</a>
      </nav>
      <div class="nav-actions">
        <a class="gh" href={github}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          <span>GitHub</span>
        </a>
        <a class="btn btn-primary btn-sm" href={href('download/')}>Download</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            <h1 id="hero-title">Your AI agent writes the API requests. You see them in Kurlo.</h1>
            <p class="lead">Kurlo is a free, open-source API client for HTTP, GraphQL, gRPC, WebSocket and more. Collections are plain YAML in your repo, so your team reviews them in Git and your agent keeps them up to date.</p>
            <div class="cta">
              <a class="btn btn-primary" href={href('download/')} data-os-download>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-os-label>Download Kurlo</span>
              </a>
              <a class="btn btn-quiet" href="#agents">How it works</a>
              <div class="cmd">
                <span class="cmd-prompt" aria-hidden="true">$</span>
                <code data-cmd>npx -y @kurlo/cli mcp install</code>
                <button class="cmd-copy" type="button" data-cmd-copy aria-label="Copy the install command">
                  <svg class="cmd-icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.8"/></svg>
                  <svg class="cmd-icon-done" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <p class="cta-note">Connects Kurlo to Claude Code, Codex, Cursor and other AI clients.</p>
            <p class="facts">{facts.join(' · ')}</p>
          </div>
          <figure class="demo demo-stack" data-demo aria-label="An AI agent adds a Refund order request with tests to the Shop API collection through kurlo mcp, runs it, saves the response as an example, and the request appears in the open Kurlo window">
            <div class="agent demo-chat">
              <div class="script-head"><span>Agent session</span><span>kurlo mcp · Local</span></div>
              <ol class="agent-log">
                <li class="agent-say" data-at="1"><span class="who">you</span><p>Add the refund endpoint I just wrote to Kurlo, with a test.</p></li>
                <li class="agent-call" data-at="2">
                  <div><span class="tool">save_request</span> <span class="dim">Shop API/Orders/Refund order</span></div>
                  <div data-at="3"><b class="ok">✓</b> created <span class="dim">requests/Refund-order.yml</span></div>
                </li>
                <li class="agent-call" data-at="4">
                  <div><span class="tool">run_request</span> <span class="dim">Refund order</span></div>
                  <div data-at="5"><b class="ok">✓</b> POST /orders/42/refund <span class="dim">→</span> 201 <span class="dim">· 84 ms · [2/2]</span></div>
                </li>
                <li class="agent-call" data-at="6">
                  <div><span class="tool">save_example</span> <span class="dim">Refunded</span></div>
                  <div><b class="ok">✓</b> 201 kept for the mock server</div>
                </li>
                <li class="agent-say" data-at="7"><span class="who">agent</span><p>Done. <em>Refund order</em> is in Orders and both tests pass.</p></li>
              </ol>
            </div>
            <div class="demo-app" aria-hidden="true">
              <div class="demo-bar"><span></span><span></span><span></span><b>Kurlo</b></div>
              <div class="demo-body">
                <div class="demo-side">
                  <div class="demo-col">Shop API</div>
                  <div class="demo-folder">Orders</div>
                  <div class="demo-row"><span class="m-get">GET</span>List orders</div>
                  <div class="demo-row"><span class="m-post">POST</span>Create order</div>
                  <div class="demo-row demo-new" data-at="3"><span class="m-post">POST</span>Refund order</div>
                  <div class="demo-folder">Payments</div>
                </div>
                <div class="demo-main">
                  <div class="demo-url" data-at="3"><span class="m-post">POST</span>&#123;&#123;baseUrl&#125;&#125;/orders/&#123;&#123;orderId&#125;&#125;/refund</div>
                  <div class="demo-meta">
                    <div class="demo-status" data-at="5"><b>201 Created</b><span>84 ms</span></div>
                    <div class="demo-chip" data-at="6">Example · Refunded</div>
                  </div>
                  <ul class="demo-tests" data-at="5">
                    <li><b>✓</b> status is 201</li>
                    <li><b>✓</b> refund amount matches the order</li>
                  </ul>
                  <div class="demo-git" data-at="7">
                    <span class="dim">Git · Shop-API · 3 changes</span>
                    <span><b>A</b> requests/Refund-order.yml</span>
                    <span><b>A</b> examples/Refund-order/Refunded.yml</span>
                    <span><b class="mod">M</b> collection.yml</span>
                  </div>
                </div>
              </div>
              <div class="demo-toast" data-at="3" data-flash>Workspace refreshed (files changed outside Kurlo)</div>
            </div>
          </figure>
        </div>
        <figure class="shot hero-shot">
          <Image src={requestEditor} alt="Kurlo with a POST request to a login endpoint, its JSON body, and a 200 OK response with one passing test" widths={[800, 1200, 1800, 2400]} sizes="(max-width: 1200px) 100vw, 1152px" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section>

    <section class="section" id="agents" aria-labelledby="agents-title">
      <div class="wrap">
        <div class="head">
          <h2 id="agents-title">What your agent can do</h2>
          <p>Kurlo is also an MCP server. One command connects it to Claude Code, Codex, Cursor, VS Code, Windsurf, Gemini CLI or Claude Desktop, and your agent works with the same collection you see in the app. <a href={href('docs/guides/mcp-server/')}>Setup and the full tool list</a></p>
        </div>
        <dl class="spec">
          {agentAbilities.map(item => (
            <div>
              <dt>{item.title}</dt>
              <dd>{withCode(item.text).map(part => ('code' in part ? <code>{part.code}</code> : part.text))}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" id="switch" aria-labelledby="switch-title">
      <div class="wrap switch">
        <div>
          <div class="head head-tight">
            <h2 id="switch-title">Coming from Postman</h2>
            <p>Export the collection as v2.1 and drop the file on Kurlo’s sidebar. Folders, auth, environments and saved responses come across, and test scripts keep running as <code>pm.*</code>, so there is nothing to rewrite.</p>
          </div>
          <p class="switch-note">Insomnia, Bruno, OpenAPI, HAR and cURL import the same way, and the original files are never touched. <a href={href('docs/getting-started/migrating/')}>Migration guide</a></p>
        </div>
        <figure class="script" aria-label="A Postman test script running unchanged in Kurlo">
          <div class="script-head"><span>Login user · Tests</span><span>imported from Postman</span></div>
          <pre set:html={scriptSnippet} />
          <div class="script-out">
            <div><b>✓</b> status is 200 <span>· 0.4 ms</span></div>
            <div><b>✓</b> returns a session <span>· 0.6 ms</span></div>
          </div>
        </figure>
      </div>
    </section>

    <section class="section" id="features" aria-labelledby="features-title">
      <div class="wrap">
        <div class="head">
          <h2 id="features-title">What’s in it</h2>
          <p>Everything ships in the same free download. Nothing needs a plan, a login or a Kurlo server.</p>
        </div>
        <dl class="spec">
          {features.map(feature => (
            <div>
              <dt><a href={href(feature.link)}>{feature.title}</a></dt>
              <dd>{withCode(feature.text).map(part => ('code' in part ? <code>{part.code}</code> : part.text))}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" id="compare" aria-labelledby="compare-title">
      <div class="wrap">
        <div class="head">
          <h2 id="compare-title">Next to Postman, Insomnia and Bruno</h2>
          <p>All four send requests well. They differ in what you pay, where your data lives and what you need an account for.</p>
        </div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Comparison of Kurlo, Postman, Insomnia and Bruno">
          <table class="compare">
            <thead>
              <tr>
                <td></td>
                {tools.map((tool, i) => (
                  <th scope="col" class={i === 0 ? 'col-kurlo' : undefined}>
                    {i === 0 ? <span><img src={logo.src} alt="" width="20" height="20" />{tool}</span> : tool}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparison.map(row => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell, i) => (
                    <td class={i === 0 ? 'col-kurlo' : undefined}>
                      <span class={cell.mark}><span>{withCode(cell.text).map(part => ('code' in part ? <code>{part.code}</code> : part.text))}</span></span>
                      {cell.note && <span class="note">{cell.note}</span>}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="compare-foot">Checked against each vendor’s public pricing page and documentation on 5 October 2026. Prices are per user per month on annual billing. If something here is out of date, <a href={`${github}/issues`}>open an issue</a>.</p>
      </div>
    </section>

    <section class="section" id="download" aria-labelledby="download-title">
      <div class="wrap">
        <div class="head">
          <h2 id="download-title">Download</h2>
          <p>Open the app and send: there is no sign-up in between. Updates are signed and install themselves. Questions are answered in the <a href={href('docs/faq/')}>FAQ</a>.</p>
        </div>
        <div class="platforms">
          <a class="platform" href={releases} data-platform="mac">
            <span class="platform-name">macOS <span class="platform-here">Your system</span></span>
            <span class="platform-meta">Universal .dmg</span>
          </a>
          <a class="platform" href={releases} data-platform="windows">
            <span class="platform-name">Windows <span class="platform-here">Your system</span></span>
            <span class="platform-meta">x64 and Arm64, no admin</span>
          </a>
          <a class="platform" href={releases} data-platform="linux">
            <span class="platform-name">Linux <span class="platform-here">Your system</span></span>
            <span class="platform-meta">x64 .AppImage</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-row">
      <span>© 2026 Kurlo · MIT licensed</span>
      <nav aria-label="Footer">
        <a href={href('docs/getting-started/installation/')}>Docs</a>
        <a href={href('download/')}>Download</a>
        <a href={href('changelog/')}>Changelog</a>
        <a href={href('privacy/')}>Privacy</a>
        <a href={github}>GitHub</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const ua = navigator.userAgent || '';
      const platform = (navigator.userAgentData && navigator.userAgentData.platform) || '';
      const os = /Win/i.test(platform) || /Windows/i.test(ua) ? 'windows'
        : (/mac/i.test(platform) || /Macintosh/i.test(ua)) && !/iPhone|iPad/i.test(ua) ? 'mac'
        : (/linux/i.test(platform) || /Linux|X11/i.test(ua)) && !/Android/i.test(ua) ? 'linux'
        : '';
      const names = { mac: 'macOS', windows: 'Windows', linux: 'Linux' };
      if (os) {
        document.documentElement.dataset.kurloOs = os;
        const label = document.querySelector('[data-os-label]');
        if (label) label.textContent = `Download for ${names[os]}`;
        document.querySelector(`.platform[data-platform="${os}"]`)?.classList.add('platform-current');
      }

      const nav = document.querySelector('[data-nav]');
      const mark = () => nav && nav.classList.toggle('nav-scrolled', scrollY > 8);
      mark();
      addEventListener('scroll', mark, { passive: true });

      const copy = document.querySelector('[data-cmd-copy]');
      const cmd = document.querySelector('[data-cmd]');
      if (copy && cmd) {
        let reset;
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(cmd.textContent);
            copy.dataset.copied = '';
            copy.setAttribute('aria-label', 'Copied');
          } catch {
            const range = document.createRange();
            range.selectNodeContents(cmd);
            const selection = getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
          }
          clearTimeout(reset);
          reset = setTimeout(() => { delete copy.dataset.copied; copy.setAttribute('aria-label', 'Copy the install command'); }, 1600);
        });
      }

      const demo = document.querySelector('[data-demo]');
      if (demo) {
        const steps = [...demo.querySelectorAll('[data-at]')];
        const show = stage => steps.forEach(step => step.classList.toggle('on', Number(step.dataset.at) <= stage));
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const times = [400, 1500, 2600, 4200, 5300, 6800, 8300];
        let timers = [];
        const stop = () => { timers.forEach(clearTimeout); timers = []; };
        const play = () => {
          stop();
          if (still.matches) { demo.classList.remove('demo-anim'); show(times.length); return; }
          demo.classList.add('demo-anim');
          show(0);
          times.forEach((at, i) => timers.push(setTimeout(() => show(i + 1), at)));
          timers.push(setTimeout(play, 14500));
        };
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(entries => entries.forEach(entry => (entry.isIntersecting ? play() : stop())), { threshold: 0.35 }).observe(demo);
        } else {
          show(times.length);
        }
        still.addEventListener?.('change', play);
      }
    })();
  </script>

  <script>
    import { findAsset, latestRelease } from '../scripts/latest-release';

    const SUFFIXES: Record<string, string> = {
      mac: '-darwin-universal.dmg',
      windows: '-windows-amd64-installer.exe',
      linux: '-linux-amd64.AppImage',
    };

    const os = document.documentElement.dataset.kurloOs ?? '';
    const button = document.querySelector<HTMLAnchorElement>('[data-os-download]');
    const suffix = SUFFIXES[os];

    if (button && suffix) {
      const release = await latestRelease();
      const asset = release && findAsset(release, suffix);
      if (asset) {
        button.href = asset.browser_download_url;
        button.setAttribute('download', '');
      }
    }
  </script>
</body>
</html>
