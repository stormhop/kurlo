---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/landing.css';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import requestEditor from '../assets/screenshots/request-editor.png';
import requestMcp from '../assets/screenshots/request-mcp.png';
import runnerResults from '../assets/screenshots/collection-runner-results.png';
import mockServer from '../assets/landing/mock-server.png';
import gitWorkspace from '../assets/landing/git-workspace.png';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const site = Astro.site ? new URL(base, Astro.site).toString() : base;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const title = 'Kurlo — the API client with no pricing page';
const description = 'A free, open-source desktop API client for HTTP, GraphQL, gRPC, WebSocket, Socket.IO, SSE and MCP. No account, no seats, no cloud, no telemetry. Imports Postman, Insomnia and Bruno.';
const releases = 'https://github.com/stormhop/kurlo/releases/latest';
const github = 'https://github.com/stormhop/kurlo';

const protocols = ['HTTP/1.1 & 2', 'GraphQL', 'gRPC', 'WebSocket', 'Socket.IO', 'SSE', 'MCP'];
const imports = ['Postman', 'Insomnia', 'Bruno', 'OpenAPI', 'HAR', 'cURL'];
const heroMeta = ['MIT licensed', 'No telemetry', 'macOS, Windows, Linux'];

const migrations = [
  {
    id: 'postman',
    label: 'Postman',
    steps: [
      { title: 'Export the collection.', text: 'Right-click it in Postman, choose Export, then Collection v2.1. Export environments from the Environments list.' },
      { title: 'Drop the files on Kurlo’s sidebar.', text: 'The format is detected for you. The folder tree, auth, scripts and examples are kept.' },
      { title: 'Pick the environment and send.', text: 'Your tests run as they did in Postman. Export back to v2.1 any time a teammate still needs it.' },
    ],
  },
  {
    id: 'insomnia',
    label: 'Insomnia',
    steps: [
      { title: 'Export your data.', text: 'In Insomnia, open Preferences, then Data, then Export Data as Insomnia v4 JSON.' },
      { title: 'Drop the file on Kurlo’s sidebar.', text: 'Each workspace becomes a collection, request groups become folders, and environments come along.' },
      { title: 'Check template tags.', text: 'Plain variables carry over. Custom Nunjucks tags such as timestamps move into a pre-request script.' },
    ],
  },
  {
    id: 'bruno',
    label: 'Bruno',
    steps: [
      { title: 'Use the YAML format.', text: 'Bruno 4.1 and later convert a .bru collection to OpenCollection YAML in one click.' },
      { title: 'Import the collection folder.', text: 'Choose Bruno / OpenCollection in Kurlo’s import dialog. Empty folders and saved responses are kept.' },
      { title: 'Keep using Git.', text: 'Kurlo workspaces are YAML in a repository too, so your review flow stays the same.' },
    ],
  },
];

const checks = [
  { title: 'CORS preflight', text: 'Sent when the method or headers need it. Allowed methods, headers and Max-Age are checked.' },
  { title: 'Credentials', text: 'Cookies are held back cross-origin unless you include them, and a wildcard origin then fails.' },
  { title: 'CSP connect-src', text: 'Paste the page’s policy. A blocked URL fails before Kurlo connects, and every redirect is checked again.' },
  { title: 'Origin and Sec-Fetch', text: 'A browser User-Agent, Origin and Sec-Fetch headers, worked out from scheme, host and port.' },
];

const extras = [
  { title: 'Your browser’s cookies', text: 'Pair the extension for Chrome, Edge, Brave or Firefox and send with the session you’re already signed into.', link: 'docs/guides/cookies/' },
  { title: 'Every environment side by side', text: 'A matrix of variables across environments. The token missing from staging is one glance away.', link: 'docs/guides/environments/' },
  { title: 'Auth set once per collection', text: 'Headers, auth, scripts and settings defined on a collection apply to every request inside it.', link: 'docs/guides/collection-defaults/' },
  { title: 'Keyboard first', text: 'A command palette and rebindable shortcuts that follow the physical key on any layout.', link: 'docs/reference/keyboard-shortcuts/' },
  { title: 'History you can reopen', text: 'Every send with its response, kept for 14 days. Open an old one back in the editor.', link: 'docs/guides/history/' },
  { title: 'Large responses stay fast', text: 'Bodies over 10 MB are paged instead of freezing the window. Images, HTML and PDFs preview inline.', link: 'docs/guides/response-viewer/' },
];

const agentClients = [
  {
    id: 'install',
    label: 'Every client',
    code: [
      '<span class="d">$</span> npx -y @kurlo/cli mcp install --env Staging',
      'Claude Code  added   user config',
      'Cursor       added   ~/.cursor/mcp.json',
      'Codex        added   ~/.codex/config.toml',
      '',
      '<span class="d"># or for the whole team, in the repository</span>',
      '<span class="d">$</span> npx -y @kurlo/cli mcp install --project',
    ].join('\n'),
  },
  {
    id: 'claude-code',
    label: 'Claude Code',
    code: '<span class="d">$</span> claude mcp add kurlo -- npx -y @kurlo/cli mcp --env Staging',
  },
  {
    id: 'codex',
    label: 'Codex',
    code: [
      '<span class="d">$</span> codex mcp add kurlo -- npx -y @kurlo/cli mcp --env Staging',
      '',
      '<span class="d"># or in ~/.codex/config.toml</span>',
      '[mcp_servers.kurlo]',
      'command = "npx"',
      'args = ["-y", "@kurlo/cli", "mcp", "--env", "Staging"]',
    ].join('\n'),
  },
  {
    id: 'mcp-json',
    label: 'Cursor and other clients',
    code: [
      '<span class="d">// .cursor/mcp.json or claude_desktop_config.json</span>',
      '{',
      '  "mcpServers": {',
      '    "kurlo": {',
      '      "command": "npx",',
      '      "args": ["-y", "@kurlo/cli", "mcp", "--env", "Staging"]',
      '    }',
      '  }',
      '}',
    ].join('\n'),
  },
];

const agentTicks = [
  'Runs saved requests with their collection auth, scripts and tests',
  'Adds and changes requests and tests as plain YAML, never secrets',
  'Reads the last request you sent from the app, so you debug together',
  'Environments you protect stay out of its reach',
];

type Mark = 'yes' | 'part' | 'no';
type Cell = { mark: Mark; text: string; note?: string };
const tools = ['Kurlo', 'Postman', 'Insomnia', 'Bruno'];
const comparison: { label: string; cells: Cell[] }[] = [
  {
    label: 'Price',
    cells: [
      { mark: 'yes', text: 'Free, every feature' },
      { mark: 'part', text: 'Free for 1 user', note: 'Team plan $19 per user a month' },
      { mark: 'part', text: 'Free up to 3 Git Sync users', note: 'Pro $12 per user a month' },
      { mark: 'part', text: 'Free: 2 workspaces, 5 OpenAPI syncs a month', note: 'Pro $6, Ultimate $11 per user a month' },
    ],
  },
  {
    label: 'Account',
    cells: [
      { mark: 'yes', text: 'Not needed' },
      { mark: 'part', text: 'Required for collections', note: 'Signed out, it only sends one-off requests' },
      { mark: 'part', text: 'Required beyond Scratch Pad' },
      { mark: 'yes', text: 'Not needed' },
    ],
  },
  {
    label: 'Where collections live',
    cells: [
      { mark: 'yes', text: 'Your disk and your Git repo' },
      { mark: 'part', text: 'Postman’s cloud', note: 'Local vault for secrets' },
      { mark: 'part', text: 'Cloud, local or Git' },
      { mark: 'yes', text: 'Your disk and your Git repo' },
    ],
  },
  {
    label: 'Team sharing',
    cells: [
      { mark: 'yes', text: 'Any Git host, no seat limit' },
      { mark: 'part', text: 'Cloud workspaces', note: 'Paid for teams' },
      { mark: 'part', text: 'Git Sync', note: 'Free up to 3 users' },
      { mark: 'part', text: 'Git', note: 'Private Git providers need Pro' },
    ],
  },
  {
    label: 'Source code',
    cells: [
      { mark: 'yes', text: 'MIT' },
      { mark: 'no', text: 'Closed' },
      { mark: 'yes', text: 'Apache-2.0' },
      { mark: 'yes', text: 'MIT core', note: 'Paid editions on top' },
    ],
  },
  {
    label: 'Built on',
    cells: [
      { mark: 'yes', text: 'Native Go with the system WebView' },
      { mark: 'part', text: 'Electron' },
      { mark: 'part', text: 'Electron' },
      { mark: 'part', text: 'Electron' },
    ],
  },
  {
    label: 'Postman scripts',
    cells: [
      { mark: 'yes', text: 'Run as written in pm.*' },
      { mark: 'yes', text: 'Native' },
      { mark: 'part', text: 'Compatibility layer' },
      { mark: 'part', text: 'Converted to bru.* on import', note: 'Complex scripts need rewriting' },
    ],
  },
  {
    label: 'Mock server',
    cells: [
      { mark: 'yes', text: 'Local, no request cap', note: 'Works offline, no account' },
      { mark: 'part', text: 'Cloud-hosted', note: 'Unlimited since March 2026, needs an account' },
      { mark: 'part', text: '1,000 mock requests a month on free' },
      { mark: 'yes', text: 'Local' },
    ],
  },
  {
    label: 'Browser CORS and CSP checks',
    cells: [
      { mark: 'yes', text: 'Built in' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
    ],
  },
  {
    label: 'Sync cookies from your browser',
    cells: [
      { mark: 'yes', text: 'Extension for Chromium and Firefox' },
      { mark: 'yes', text: 'Interceptor extension' },
      { mark: 'no', text: 'No' },
      { mark: 'no', text: 'No' },
    ],
  },
];

const faq = [
  { q: 'Is it really free?', a: 'Yes. There is no paid plan, no locked feature and no seat limit. The code is MIT-licensed, so you can read it or build it yourself.' },
  { q: 'Do I need an account?', a: 'No. Open the app and send. There is no Kurlo server to sign in to.' },
  { q: 'Where is my data?', a: 'On your disk, encrypted with AES-256-GCM. The key lives in macOS Keychain, Windows DPAPI or libsecret on Linux.' },
  { q: 'Does Kurlo send anything home?', a: 'No analytics and no crash reports. The network carries your requests, OAuth, Git and the update check. Nothing else.' },
  { q: 'How does my team share collections?', a: 'Put the workspace in a Git repository. Requests are YAML you review in pull requests; secrets stay on each machine.' },
  { q: 'Will my Postman scripts work?', a: 'Most run unchanged, including pm.sendRequest, CryptoJS and require for lodash, ajv, chai and uuid. setTimeout, async and await, and postman.setNextRequest aren’t supported yet.' },
  { q: 'Can I run tests in CI?', a: 'npx @kurlo/cli run ./workspace --env CI runs the same requests and scripts, writes JUnit or JSON, and exits non-zero on a failed test. No desktop app needed on the runner.' },
  { q: 'macOS says the app can’t be opened.', a: 'Builds aren’t notarized by Apple yet. Right-click Kurlo.app, choose Open, and confirm once. Every update is checked against a SHA-256 hash and a minisign signature before it installs.' },
  { q: 'Is it maintained?', a: 'New versions ship often, and every change is listed in the public changelog. Updates install from inside the app.' },
  { q: 'Which platforms?', a: 'macOS on Apple silicon and Intel, Windows 10 and 11 on x64 and Arm64, and Linux x64 as an AppImage.' },
];

const codeTerms = /(pm\.sendRequest|CryptoJS|require|setTimeout|postman\.setNextRequest|npx @kurlo\/cli run \.\/workspace --env CI|kurlo run|kurlo mcp|pm\.\*|bru\.\*)/g;
const withCode = (text: string) => text.split(codeTerms).map((part, i) => (i % 2 ? { code: part } : { text: part }));

const pricingBody = '<span>content-type</span>: text/plain\n\nEvery feature is in the free app.\nThere is nothing to upgrade to.';

const scriptSnippet = [
  '<span class="c">// unchanged from the Postman export</span>',
  '<span class="f">pm.test</span>(<span class="s">"status is 200"</span>, () =&gt; {',
  '  pm.response.to.have.status(200)',
  '})',
  '',
  '<span class="f">pm.test</span>(<span class="s">"returns a session"</span>, () =&gt; {',
  '  const body = pm.response.json()',
  '  pm.expect(body).to.have.property(<span class="s">"token"</span>)',
  '  pm.environment.set(<span class="s">"token"</span>, body.token)',
  '})',
].join('\n');

const ldJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kurlo',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Windows, Linux',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: site,
  downloadUrl: releases,
  sameAs: [github],
});
---

<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={site} />
  <link rel="icon" href={href('favicon-32.png')} type="image/png" />
  <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
  <link rel="sitemap" href={href('sitemap-index.xml')} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={site} />
  <meta property="og:image" content={`${site}og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={`${site}og.png`} />
  <meta name="color-scheme" content="light dark" />
  <script is:inline>
    (() => {
      let stored = null;
      try { stored = localStorage.getItem('starlight-theme'); } catch {}
      const theme = stored === 'light' || stored === 'dark'
        ? stored
        : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <script is:inline type="application/ld+json" set:html={ldJson} />
</head>
<body class="landing">
  <a class="skip" href="#main">Skip to content</a>

  <header class="nav" data-nav>
    <div class="wrap nav-row">
      <a class="brand" href={base} aria-label="Kurlo home">
        <img src={logo.src} alt="" width="28" height="28" />
        <span>Kurlo</span>
      </a>
      <nav class="nav-links" aria-label="Site">
        <a href="#tour">Features</a>
        <a href="#agents">AI agents</a>
        <a href="#browser">Browser checks</a>
        <a href="#compare">Compare</a>
        <a href="#faq">FAQ</a>
        <a href={href('docs/getting-started/installation/')}>Docs</a>
      </nav>
      <div class="nav-actions">
        <a class="gh" href={github}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          <span>GitHub</span>
        </a>
        <a class="btn btn-primary btn-sm" href={href('download/')}>Download</a>
      </div>
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <div class="hero-grid">
          <div>
            <h1 id="hero-title">The API client with <span>no pricing page.</span></h1>
            <p class="lead">Kurlo is a free, open-source desktop app for HTTP, GraphQL, gRPC, WebSocket, Socket.IO, SSE and MCP. No account, no seats, no cloud. Your collections are files on your disk, and Git is how your team shares them.</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href={href('download/')} data-os-download>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-os-label>Download Kurlo</span>
              </a>
              <a class="btn btn-quiet" href="#switch">Bring my Postman collection</a>
            </div>
            <a class="hero-agents" href="#agents">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M7.5 7.5l-2-2m13 13-2-2m0-9 2-2m-13 13 2-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/></svg>
              <span>Works with Claude Code, Codex, Cursor and any MCP client&nbsp;→</span>
            </a>
            <ul class="hero-meta">
              {heroMeta.map(item => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <figure class="probe" aria-label="A request to kurlo.dev/pricing returns 404 Not Found">
            <div class="probe-head"><span class="probe-method">GET</span><span class="probe-url">https://kurlo.dev/pricing</span></div>
            <div class="probe-status"><b>404 Not Found</b><span>38 ms</span><span>66 B</span></div>
            <pre set:html={pricingBody} />
            <div class="probe-foot">✓ pm.test("no paywall") <span>· 1/1 passed</span></div>
          </figure>
        </div>

        <figure class="shot hero-shot">
          <Image src={requestEditor} alt="Kurlo with a POST request to a login endpoint, its JSON body, and a 200 OK response with one passing test" widths={[800, 1200, 1800, 2400]} sizes="(max-width: 1200px) 100vw, 1152px" loading="eager" fetchpriority="high" />
        </figure>
      </div>

      <div class="formats" aria-label="Protocols and import formats">
        <div class="wrap">
          <div class="formats-row">
            <span class="formats-label">Speaks</span>
            <ul>{protocols.map(item => <li>{item}</li>)}</ul>
          </div>
          <div class="formats-row">
            <span class="formats-label">Imports from</span>
            <ul>{imports.map(item => <li>{item}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="switch" aria-labelledby="switch-title">
      <div class="wrap">
        <div class="head">
          <h2 id="switch-title">Switching takes one import, not a weekend.</h2>
          <p>Folders, auth, environments and saved responses come across. Postman test scripts keep running as <code>pm.*</code>, so you don’t rewrite them in a new dialect.</p>
        </div>
        <div class="switch">
          <div>
            <div class="tabs" role="tablist" aria-label="Coming from">
              {migrations.map((source, i) => (
                <button class="tab" type="button" role="tab" id={`from-${source.id}`} aria-controls={`steps-${source.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{source.label}</button>
              ))}
            </div>
            {migrations.map((source, i) => (
              <ol class="steps" role="tabpanel" id={`steps-${source.id}`} aria-labelledby={`from-${source.id}`} hidden={i !== 0}>
                {source.steps.map(step => (
                  <li><div><b>{step.title}</b><p>{step.text}</p></div></li>
                ))}
              </ol>
            ))}
            <p class="switch-note">The import never touches your original files. <a href={href('docs/getting-started/migrating/')}>Full migration guide →</a></p>
          </div>

          <figure class="script" aria-label="A Postman test script running unchanged in Kurlo">
            <div class="script-head"><span>Login user · Tests</span><span>imported from Postman</span></div>
            <pre set:html={scriptSnippet} />
            <div class="script-out">
              <div><b>✓</b> status is 200 <span>· 0.4 ms</span></div>
              <div><b>✓</b> returns a session <span>· 0.6 ms</span></div>
            </div>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" id="agents" aria-labelledby="agents-title">
      <div class="wrap">
        <div class="head">
          <h2 id="agents-title">Your AI agent can run your requests.</h2>
          <p>Kurlo is also an MCP server. Connect Claude Code, Codex, Cursor or any MCP client, and the agent can send your saved requests, run their tests and keep them up to date. Your tokens reach the API; the model only ever sees <code>[secret]</code>.</p>
        </div>
        <div class="agents">
          <div>
            <div class="tabs" role="tablist" aria-label="MCP client">
              {agentClients.map((client, i) => (
                <button class="tab" type="button" role="tab" id={`agent-${client.id}`} aria-controls={`agent-panel-${client.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{client.label}</button>
              ))}
            </div>
            {agentClients.map((client, i) => (
              <pre class="cli agent-cli" role="tabpanel" id={`agent-panel-${client.id}`} aria-labelledby={`agent-${client.id}`} hidden={i !== 0} set:html={client.code} />
            ))}
            <p class="agent-note">npx fetches Kurlo from npm, with or without the app installed. When the app is installed, clients start the server from it.</p>
            <ul class="ticks">{agentTicks.map(item => <li><span>{withCode(item).map(part => ('code' in part ? <code>{part.code}</code> : part.text))}</span></li>)}</ul>
            <a class="tour-link" href={href('docs/guides/mcp-server/')}>Connect an assistant →</a>
          </div>

          <figure class="agent" aria-label="An AI agent runs the Checkout collection through kurlo mcp, finds the failing payment request and explains why">
            <div class="script-head"><span>Agent session</span><span>kurlo mcp · Staging</span></div>
            <ol class="agent-log">
              <li class="agent-say"><span class="who">you</span><p>Check that checkout still works on staging.</p></li>
              <li class="agent-call">
                <div><span class="tool">run_collection</span> <span class="dim">Checkout</span></div>
                <div><b class="ok">✓</b> POST /cart <span class="dim">→</span> 201 <span class="dim">[2/2]</span></div>
                <div><b class="ok">✓</b> POST /orders <span class="dim">→</span> 201 <span class="dim">[3/3]</span></div>
                <div><b class="err">✗</b> POST /payments <span class="dim">→</span> <span class="err">422</span> <span class="dim">[0/1]</span></div>
              </li>
              <li class="agent-call">
                <div><span class="tool">get_request</span> <span class="dim">Checkout/Create payment</span></div>
                <div class="dim">"amount": "&#123;&#123;total&#125;&#125;", "currency": "EUR"</div>
              </li>
              <li class="agent-say"><span class="who">agent</span><p>Payments fails: the body sends <em>amount</em> as a string, and the API now wants a number. Remove the quotes around <em>&#123;&#123;total&#125;&#125;</em>?</p></li>
            </ol>
