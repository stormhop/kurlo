---
import SiteLayout from '../../components/SiteLayout.astro';
import Scene from '../../components/Scene.astro';
import DownloadButton from '../../components/site/DownloadButton.astro';
import EndCta from '../../components/site/EndCta.astro';
import Rich from '../../components/site/Rich.astro';
import { CHECKED_ON, competitors, type Competitor } from '../../lib/competitors';
import { RECEIPTS_CHECKED_ON, apps, formatMb, mb, platforms, timesSmaller } from '../../lib/receipts';
import { structuredData } from '../../../site.schema.mjs';

export function getStaticPaths() {
  return competitors.map(competitor => ({ params: { tool: competitor.slug }, props: { competitor } }));
}

const { competitor } = Astro.props as { competitor: Competitor };
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const site = Astro.site ? new URL(base, Astro.site).toString() : base;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;
const pageUrl = new URL(`vs/${competitor.slug}/`, site).href;

const terms = /(pm\.test|pm\.expect|pm\.sendRequest|pm\.\*|bru\.\*|kurlo mcp|tests\[\]|postman\.setEnvironmentVariable|\{\{variables\}\})/g;

const kurloApp = apps[0];
const rival = apps.find(app => app.name === competitor.name);
const sizes = rival
  ? platforms.map(platform => ({
      platform,
      times: timesSmaller(platform.id, rival),
      rows: [kurloApp, rival].map(app => ({ app, download: app.downloads[platform.id] })),
      top: Math.max(mb(kurloApp.downloads[platform.id].bytes), mb(rival.downloads[platform.id].bytes)),
    }))
  : [];

const ldJson = structuredData({
  siteRoot: site,
  description: competitor.description,
  page: { url: pageUrl, name: competitor.title, description: competitor.description },
});
---

<SiteLayout title={competitor.title} description={competitor.description} canonical={pageUrl} ldJson={ldJson} links={[{ label: 'Compare', href: '#compare' }, { label: 'Why switch', href: '#why' }, { label: 'Migrate', href: '#migrate' }, { label: 'MCP', href: href('mcp/') }]}>
  <section class="k-hero k-hero-short" data-hero aria-labelledby="hero-title">
    <Scene variant="dusk" bird />
    <div class="k-hero-copy">
      <p class="k-label k-label-hero">Kurlo vs {competitor.name}</p>
      <h1 id="hero-title" class="k-h1-long"><span>Kurlo</span><span>vs {competitor.name}.</span></h1>
      <p class="k-lead"><Rich text={competitor.lead} terms={terms} /></p>
      <div class="k-cta">
        <DownloadButton />
        <a class="k-source" href="#migrate">Move from {competitor.name}</a>
      </div>
    </div>
  </section>

  <section class="k-wrap k-wrap-flush" id="compare" aria-labelledby="compare-title">
    <p class="k-label">Checked {CHECKED_ON}</p>
    <h2 class="k-display" id="compare-title">Side by side.</h2>
    <table class="k-compare">
      <thead>
        <tr>
          <td></td>
          <th scope="col" class="k-col-kurlo">Kurlo</th>
          <th scope="col">{competitor.name}</th>
        </tr>
      </thead>
      <tbody>
        {competitor.rows.map(row => (
          <tr>
            <th scope="row">{row.label}</th>
            {[row.kurlo, row.other].map((cell, i) => (
              <td class={i === 0 ? 'k-col-kurlo' : undefined}>
                <span class={`k-cell k-cell-${cell.mark}`}>
                  <span><Rich text={cell.text} terms={terms} /></span>
                  {cell.note && <small>{cell.note}</small>}
                </span>
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="k-fine">Checked against {competitor.sources.map((source, i) => (<>{i > 0 && ', '}<a href={source.url}>{source.label}</a></>))} and the vendor’s documentation on {CHECKED_ON}. Prices are per user per month on annual billing. If something here is out of date, <a href="https://github.com/stormhop/kurlo/issues">open an issue</a>.</p>
  </section>

  {rival && (
    <section class="k-receipts" aria-labelledby="receipts-title" data-tabs>
      <p class="k-label">Download size, measured</p>
      <h2 class="k-display" id="receipts-title">Receipts.</h2>
      <div class="k-receipt-tabs" role="tablist" aria-label="Platform">
        {platforms.map((platform, i) => (
          <button type="button" role="tab" class={i === 0 ? 'on' : ''} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={platform.id}>{platform.label}</button>
        ))}
      </div>
      {sizes.map((size, i) => (
        <div class="k-receipt" role="tabpanel" aria-label={size.platform.label} data-panel={size.platform.id} hidden={i !== 0}>
          <div class="k-big"><b>{size.times}×</b><span>smaller download than {competitor.name} on {size.platform.label}</span></div>
          <div class="k-bars">
            {size.rows.map(row => (
              <div class={`k-bar ${row.app === kurloApp ? 'k-bar-kurlo' : ''}`}>
                <span>{row.app.name}<i>{row.download.file}</i></span>
                <div><i style={`--w:${((mb(row.download.bytes) / size.top) * 100).toFixed(2)}%`}></i></div>
                <b>{formatMb(row.download.bytes)}</b>
              </div>
            ))}
          </div>
        </div>
      ))}
      <p class="k-fine">Official downloads on {RECEIPTS_CHECKED_ON}: <a href={kurloApp.source}>Kurlo {kurloApp.version}</a> and <a href={rival.source}>{rival.name} {rival.version}</a>. 1 MB is 1,048,576 bytes.</p>
    </section>
  )}

  <section class="k-wrap" id="why" aria-labelledby="why-title">
    <p class="k-label">Why switch</p>
    <h2 class="k-display" id="why-title">Why people move.</h2>
    <div class="k-reasons">
      {competitor.reasons.map((item, i) => (
        <div>
          <p class="k-no"><span class="k-dot" aria-hidden="true"></span>No. {String(i + 1).padStart(2, '0')}</p>
          <h3>{item.title}</h3>
          <p><Rich text={item.text} terms={terms} /></p>
        </div>
      ))}
    </div>
  </section>

  <section class="k-wrap" id="migrate" aria-labelledby="migrate-title">
    <p class="k-label">Moving from {competitor.name}</p>
    <h2 class="k-display" id="migrate-title">Bring it all.</h2>
    <p class="k-sub">{competitor.migrate.intro} <a href={href(competitor.migrate.link)}>Migration guide</a></p>
    <ol class="k-steps">
      {competitor.migrate.steps.map(step => <li>{step}</li>)}
    </ol>
    <p class="k-carries"><b>What comes across:</b> <Rich text={competitor.migrate.carries} terms={terms} /></p>
  </section>

  <EndCta title="Switch it." lead={`Import your ${competitor.name} collection and keep working. No account, nothing to rewrite.`} />
</SiteLayout>
