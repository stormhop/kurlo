---
import SiteLayout from '../components/SiteLayout.astro';
import Scene from '../components/Scene.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const href = (path: string) => `${base}${path.replace(/^\//, '')}`;

const title = 'Page not found — Kurlo';
const description = 'This page does not exist. The Kurlo docs, download and home page are one click away.';
const places = [
  { label: 'Home', path: '' },
  { label: 'Docs', path: 'docs/' },
  { label: 'Download', path: 'download/' },
  { label: 'MCP', path: 'mcp/' },
  { label: 'Changelog', path: 'changelog/' },
];
---

<SiteLayout title={title} description={description} noindex>
  <section class="k-hero" data-hero data-bird-home="0.5 0.14" data-replies="404 Not Found · 12 ms|still 404 · 9 ms|404, but the bird is fine|try the docs · 200 OK" aria-labelledby="hero-title">
    <Scene variant="night" bird />
    <div class="k-hero-copy k-miss">
      <div>
        <p class="k-label k-label-hero">GET <span data-path>/this-page</span> → 404</p>
        <h1 id="hero-title"><span>Lost</span><span>bird.</span></h1>
        <p class="k-lead">This page flew off somewhere and didn’t come back. Everything else is still where you left it.</p>
        <div class="k-cta">
          <a class="k-btn k-btn-solid" href={base}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5h-5v5H5a1 1 0 0 1-1-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            <b>Back home</b>
            <span class="k-tag">200 OK</span>
          </a>
          <a class="k-source" href={href('docs/')}>Search the docs</a>
        </div>
      </div>
      <div class="k-app" data-tabs aria-label="Kurlo showing the missing page answered with 404 Not Found">
        <div class="k-app-bar"><i></i><i></i><i></i><span>Kurlo</span></div>
        <div class="k-app-body">
          <div class="k-app-main">
            <div class="k-app-url">
              <span class="k-method m-get">GET</span>
              <span class="k-url">https://kurlo.dev<span data-path>/this-page</span></span>
              <span class="k-send" aria-hidden="true"><span>Send</span></span>
            </div>
            <div class="k-app-res">
              <div class="k-app-res-head">
                <div class="k-app-tabs" role="tablist" aria-label="Response">
                  <button type="button" role="tab" class="on" aria-selected="true" tabindex="0" data-tab="body">Body</button>
                  <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tab="tests">Tests <span class="bad">0/1</span></button>
                </div>
                <div class="k-app-stat"><b class="bad">404 Not Found</b><span>12 ms</span></div>
              </div>
              <div class="k-app-res-body">
                <ul class="k-tests k-places" role="tabpanel" data-panel="body">
                  {places.map(place => <li class="ok"><b>→</b><a href={href(place.path)}>{place.label}</a></li>)}
                </ul>
                <ul class="k-tests" role="tabpanel" data-panel="tests" hidden>
                  <li class="bad"><b>✗</b>page exists<span>expected response to have status code 200 but got 404</span></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
      (() => {
        let path = location.pathname;
        try { path = decodeURIComponent(path); } catch {}
        path = path.slice(0, 60) || '/';
        document.querySelectorAll('[data-path]').forEach(node => { node.textContent = path; });
      })();
    </script>
  </Fragment>
</SiteLayout>
