---
import { Icon } from '@astrojs/starlight/components';
import { DOCS_SECTIONS } from '../../docs.sidebar.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = DOCS_SECTIONS.filter(section => section.link !== '/docs/help/');
---

<div class="docs-directory not-content">
  <h2 id="beyond-the-basics">Browse by topic</h2>
  <ul class="docs-directory-grid">
    {sections.map(section => (
      <li id={section.link === '/docs/reference/' ? 'reference' : undefined}>
        <a href={`${base}${section.link}`}>
          <span class="docs-area-icon"><Icon name={section.icon} size="1.25rem" /></span>
          <span class="docs-area-text">
            <strong>{section.label}</strong>
            <span>{section.description}</span>
          </span>
          <Icon name="right-arrow" class="area-arrow" size="1.15rem" />
        </a>
      </li>
    ))}
  </ul>
  <nav id="need-something-the-docs-dont-cover" class="docs-help-links" aria-label="Help and updates">
    <a href={`${base}/docs/help/`}><Icon name="question-circle" size="1rem" /> Help</a>
    <a href={`${base}/docs/troubleshooting/`}>Troubleshooting</a>
    <a href={`${base}/changelog/`}>Changelog</a>
  </nav>
</div>

<style>
  .docs-directory h2 {
    margin: 0 0 0.9rem;
    color: var(--sl-color-white);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .docs-directory-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-directory .docs-directory-grid > li + li {
    margin: 0;
  }
  .docs-directory-grid a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-content: start;
    align-items: start;
    gap: 0.75rem;
    min-height: 100%;
    padding: 1.05rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    background: var(--kurlo-surface);
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 150ms ease, background-color 150ms ease;
  }
  .docs-directory-grid a:hover {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, var(--kurlo-surface));
  }
  .docs-area-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .docs-area-text {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.06rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
  .docs-area-text strong {
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .docs-directory-grid a :global(.area-arrow) {
    margin-top: 0.15rem;
    color: var(--sl-color-accent-high);
  }
  .docs-help-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.45rem;
    margin-top: 1.45rem;
    padding-block: 0.8rem;
    border-block: 1px solid var(--sl-color-hairline);
  }
  .docs-help-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .docs-help-links a:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 58rem) {
    .docs-directory-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 37rem) {
    .docs-directory-grid {
      grid-template-columns: 1fr;
    }
    .docs-directory-grid a {
      padding: 0.875rem;
    }
  }
</style>
