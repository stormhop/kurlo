---
import '@fontsource/anton';
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const columns = [
  { title: 'Kurlo', links: [['Home', base], ['Download', `${base}download/`], ['MCP', `${base}mcp/`], ['Changelog', `${base}changelog/`], ['Privacy', `${base}privacy/`]] },
  { title: 'Compare', links: [['vs Postman', `${base}vs/postman/`], ['vs Insomnia', `${base}vs/insomnia/`], ['vs Bruno', `${base}vs/bruno/`]] },
  { title: 'Source', links: [['GitHub', 'https://github.com/stormhop/kurlo'], ['Report an issue', 'https://github.com/stormhop/kurlo/issues'], ['npm', 'https://www.npmjs.com/package/@kurlo/cli']] },
];
---

<Default><slot /></Default>

<div class="kurlo-site-footer not-content">
  <p class="kurlo-site-footer-line">The bird always comes back.</p>
  <div class="kurlo-site-footer-cols">
    {columns.map(column => (
      <nav aria-label={column.title}>
        <b>{column.title}</b>
        {column.links.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
    ))}
  </div>
  <span class="kurlo-site-footer-legal">© 2026 Kurlo · MIT licensed · No account, no cloud, no telemetry</span>
</div>

<style>
  .kurlo-site-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: 14px;
    background: #07081a;
    color: #a9abc6;
    font-size: var(--sl-text-sm);
  }
  .kurlo-site-footer-line {
    margin: 0;
    font-family: 'Anton', Impact, sans-serif;
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.8rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: #f7f3ea;
  }
  .kurlo-site-footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 1.5rem;
  }
  .kurlo-site-footer nav {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .kurlo-site-footer b {
    margin-bottom: 0.2rem;
    font-family: var(--sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: #6f7190;
  }
  .kurlo-site-footer a {
    color: #a9abc6;
    text-decoration: none;
  }
  .kurlo-site-footer a:hover {
    color: #f7f3ea;
  }
  .kurlo-site-footer-legal {
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8125rem;
    color: #6f7190;
  }
</style>
