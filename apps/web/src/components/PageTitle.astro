---
import DocsHero from './DocsHero.astro';

const route = Astro.locals.starlightRoute;
const { title, description } = route.entry.data;
const hub = route.id === 'docs';
---

{hub ? (
  <DocsHero description={description} />
) : (
  <>
    <h1 id="_top">{title}</h1>
    {description && <p class="kurlo-page-lead">{description}</p>}
  </>
)}

<style>
  h1 {
    margin-top: 0.75rem;
    font-size: var(--sl-text-h1);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.028em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
  .kurlo-page-lead {
    margin-top: 0.75rem;
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }
</style>
