---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname.slice(base.length - 1);
const links = [
  { label: 'Docs', href: `${base}docs/`, active: path.startsWith('/docs/') },
  { label: 'MCP', href: `${base}mcp/`, active: false },
  { label: 'Download', href: `${base}download/`, active: path.startsWith('/download/') },
  { label: 'Changelog', href: `${base}changelog/`, active: path.startsWith('/changelog/') },
];
---

<div class="kurlo-header">
  <div class="kurlo-header-title">
    <SiteTitle />
  </div>
  <div class="kurlo-header-search print:hidden">
    <Search />
  </div>
  <div class="kurlo-header-end sl-hidden md:sl-flex print:hidden">
    <nav class="kurlo-header-nav" aria-label="Site">
      {links.map(link => (
        <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <a class="kurlo-header-github" href="https://github.com/stormhop/kurlo" aria-label="Kurlo on GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <ThemeSelect />
  </div>
</div>

<style>
  .kurlo-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .kurlo-header-title {
    display: flex;
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .kurlo-header-search {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-start;
  }
  .kurlo-header-end {
    align-items: center;
    gap: 1.25rem;
  }
  .kurlo-header-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .kurlo-header-nav a {
    padding: 0.4rem 0.7rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .kurlo-header-nav a:hover {
    color: var(--sl-color-white);
    background: var(--kurlo-surface);
  }
  .kurlo-header-nav a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  .kurlo-header-github {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 8px;
    color: var(--sl-color-gray-2);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .kurlo-header-github:hover {
    color: var(--sl-color-white);
    background: var(--kurlo-surface);
  }
  @media (min-width: 50rem) {
    .kurlo-header-title {
      min-width: calc(var(--sl-sidebar-width) - 2 * var(--sl-nav-pad-x));
    }
    .kurlo-header-search {
      padding-inline-start: 0.5rem;
    }
  }
</style>
