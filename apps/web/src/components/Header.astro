---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import logo from '../assets/logo.png';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname.slice(base.length - 1);
const links = [
  { label: 'Docs', href: `${base}docs/`, active: path.startsWith('/docs/') },
  { label: 'MCP', href: `${base}mcp/`, active: false },
  { label: 'Changelog', href: `${base}changelog/`, active: path.startsWith('/changelog/') },
  { label: 'GitHub', href: 'https://github.com/stormhop/kurlo', active: false },
];
---

<div class="kurlo-header">
  <div class="kurlo-header-title">
    <a class="kurlo-brand" href={base} aria-label="Kurlo home">
      <img src={logo.src} alt="" width="30" height="30" />
      <span>kurlo</span>
    </a>
  </div>
  <div class="kurlo-header-search print:hidden">
    <Search />
  </div>
  <div class="kurlo-header-end sl-hidden md:sl-flex print:hidden">
    <nav class="kurlo-header-nav" aria-label="Site">
      {links.map(link => (
        <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <ThemeSelect />
    <a class="kurlo-header-cta" href={`${base}download/`} aria-current={path.startsWith('/download/') ? 'page' : undefined}>Download</a>
  </div>
</div>

<style>
  .kurlo-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .kurlo-header-title {
    display: flex;
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .kurlo-brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sl-color-white);
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .kurlo-brand img {
    border-radius: 8px;
  }
  .kurlo-header-search {
    display: flex;
    flex: 1 1 auto;
    justify-content: flex-start;
  }
  .kurlo-header-end {
    align-items: center;
    gap: 1.5rem;
  }
  .kurlo-header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .kurlo-header-nav a,
  .kurlo-header-cta {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .kurlo-header-nav a {
    color: var(--sl-color-gray-2);
    transition: color 0.15s ease;
  }
  .kurlo-header-nav a:hover,
  .kurlo-header-nav a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  .kurlo-header-cta {
    padding: 0.7rem 1rem;
    border-radius: 6px;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-weight: 700;
    transition: opacity 0.15s ease;
  }
  .kurlo-header-cta:hover {
    opacity: 0.88;
  }
  @media (min-width: 50rem) {
    .kurlo-header-title {
      min-width: calc(var(--sl-sidebar-width) - 2 * var(--sl-nav-pad-x));
    }
    .kurlo-header-search {
      padding-inline-start: 0.5rem;
    }
  }
</style>
