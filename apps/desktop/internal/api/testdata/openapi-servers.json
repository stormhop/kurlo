[
  {
    "name": "document alternatives",
    "spec": {
      "openapi": "3.0.3",
      "info": {
        "title": "Server cases",
        "version": "1"
      },
      "paths": {
        "/ping": {
          "get": {
            "summary": "ping",
            "responses": {
              "200": {
                "description": "OK"
              }
            }
          }
        }
      },
      "servers": [
        {
          "url": "https://prod.test/v1/",
          "description": "Production"
        },
        {
          "url": "https://sandbox.test/v1/",
          "description": "Sandbox"
        }
      ]
    },
    "sourceUrl": "",
    "variables": [
      {
        "key": "baseUrl",
        "value": "https://prod.test/v1",
        "enabled": true
      },
      {
        "key": "baseUrl",
        "value": "https://sandbox.test/v1",
        "enabled": false
      }
    ],
    "urls": {
      "ping": "{{baseUrl}}/ping"
    }
  },
