      "openapi": "3.0.3",
      "info": {
        "title": "Server cases",
        "version": "1"
      },
      "paths": {
        "/a": {
          "servers": [
            null,
            {},
            {
              "url": ""
            }
          ],
          "get": {
            "summary": "a",
            "responses": {
              "200": {
                "description": "OK"
              }
            },
            "servers": []
          }
        },
        "/b": {
          "servers": [
            {
              "url": "https://files.test"
            }
          ],
          "get": {
            "summary": "b",
            "responses": {
              "200": {
                "description": "OK"
              }
            },
            "servers": [
              null,
              {}
            ]
          }
        }
      },
      "servers": [
        null,
        {},
        {
          "url": ""
        },
        {
          "url": "https://api.test"
        }
      ]
    },
    "sourceUrl": "",
    "variables": [
      {
        "key": "baseUrl",
        "value": "https://api.test",
        "enabled": true
      }
    ],
    "urls": {
      "a": "{{baseUrl}}/a",
      "b": "{{baseUrl}}/b"
    },
    "requestVars": {
      "b": [
        {
          "key": "baseUrl",
          "value": "https://files.test",
          "enabled": true
        }
      ]
    }
  },
