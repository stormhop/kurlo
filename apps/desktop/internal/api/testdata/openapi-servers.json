  {
    "name": "shared operation references retain path servers",
    "spec": {
      "openapi": "3.0.3",
      "info": {
        "title": "Server cases",
        "version": "1"
      },
      "paths": {
        "/a": {
          "servers": [
            {
              "url": "https://one.test"
            }
          ],
          "get": {
            "$ref": "#/x-operation"
          }
        },
        "/b": {
          "servers": [
            {
              "url": "https://two.test"
            }
          ],
          "get": {
            "$ref": "#/x-operation"
          }
        }
      },
      "x-operation": {
        "summary": "shared",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "sourceUrl": "",
    "urlsByPath": true,
    "variables": [],
    "urls": {
      "GET /a": "{{baseUrl}}/a",
      "GET /b": "{{baseUrl}}/b"
    },
    "requestVars": {
      "GET /a": [
        {
          "key": "baseUrl",
          "value": "https://one.test",
          "enabled": true
        }
      ],
      "GET /b": [
        {
          "key": "baseUrl",
          "value": "https://two.test",
          "enabled": true
        }
      ]
    }
