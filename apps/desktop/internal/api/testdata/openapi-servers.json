                "description": "OK"
              }
            }
          }
        },
        "/b": {
          "servers": [
            {
              "url": "https://files.test"
            }
          ],
          "get": {
            "summary": "b",
            "responses": {
              "200": {
                "description": "OK"
              }
            }
          },
          "post": {
            "summary": "c",
            "responses": {
              "200": {
                "description": "OK"
              }
