        {
          "key": "baseUrl",
          "value": "https://one.test",
          "enabled": false
        }
      ],
      "b": [
        {
          "key": "baseUrl",
          "value": "https://api.test",
          "enabled": true
        },
        {
          "key": "baseUrl",
          "value": "https://two.test",
