      "servers": [
        {
          "url": "https://api.test"
        }
      ]
    },
    "sourceUrl": "",
    "variables": [
      {
        "key": "baseUrl",
        "value": "https://api.test",
        "enabled": true
      }
    ],
    "urls": {
      "a": "{{baseUrl}}/a",
      "b": "{{baseUrl}}/b",
      "c": "{{baseUrl}}/b"
    },
    "requestVars": {
      "b": [
        {
          "key": "baseUrl",
          "value": "https://files.test",
          "enabled": true
        }
      ],
      "c": [
        {
          "key": "baseUrl",
          "value": "https://reports.test",
          "enabled": true
